<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_dockflow" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.dockflow</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='purchase']" position="inside">
                <block title="Dockflow tracking" name="dockflow_setting_container">
                    <setting id="dockflow_opt_in" help="Track containers, bills of lading and bookings on purchase orders with Dockflow. Requires a Dockflow account.">
                        <field name="dockflow_opt_in"/>
                        <div class="text-muted mt8">
                            When switched on, Odoo sends the bill of lading, booking or container numbers you enter on
                            purchase orders, and the purchase order reference, to the Dockflow API. It receives status,
                            ports, ETD/ETA, ATD/ATA and milestones back. No other data is sent.
                        </div>
                    </setting>
                    <setting id="dockflow_connection" string="Dockflow connection" help="Create a dedicated API token for Odoo in the Dockflow API Console, with the downstream and upstream scopes and 'own tradeflows only'.">
                        <div class="content-group">
                            <div class="row mt8">
                                <label for="dockflow_token" class="col-lg-4 o_light_label"/>
                                <field name="dockflow_token" password="True"/>
                            </div>
                            <div class="row mt8">
                                <label for="dockflow_environment" class="col-lg-4 o_light_label"/>
                                <field name="dockflow_environment"/>
                            </div>
                            <div class="row mt8" invisible="dockflow_environment != 'uat'">
                                <label for="dockflow_mock_scenario" class="col-lg-4 o_light_label"/>
                                <field name="dockflow_mock_scenario" placeholder="ocean_basic"/>
                            </div>
                            <button name="action_dockflow_check_connection" type="object" string="Check connection" class="btn-link mt8 px-0"/>
                        </div>
                    </setting>
                    <setting id="dockflow_sync_receipt_date" help="Set the scheduled date of open receipts to the ETA from Dockflow.">
                        <field name="dockflow_sync_receipt_date"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
